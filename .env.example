# Copy this file to .env and fill in your values
# Never commit .env to git

# AMD Developer Cloud
# Inference is served via SGLang (OpenAI-compatible API) on AMD GPUs.
# Get the real endpoint URL + key from the AMD Developer Cloud dashboard
# once credits are activated.
AMD_API_KEY=your_amd_api_key_here
AMD_API_BASE_URL=https://api.amd.com/v1  # replace with the real SGLang endpoint

# Model config
# Team default: Llama-3.1-8B-Instruct (better tool calling + JSON adherence
# than Mistral-7B for our CrewAI agents; 128K context vs Llama-3.0's 8K).
# If AMD's deployment only has 3.0, drop the .1 — same tradeoffs hold.
MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
MODEL_TEMPERATURE=0.7

# Optional: tracing / observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
