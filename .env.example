# Copy this file to .env and fill in your values
# Never commit .env to git

# AMD Developer Cloud
AMD_API_KEY=your_amd_api_key_here
AMD_API_BASE_URL=https://api.amd.com/v1  # update with actual endpoint

# Model config
MODEL_NAME=meta-llama/Llama-3-8b-instruct  # or deepseek, mistral, qwen
MODEL_TEMPERATURE=0.7

# Optional: tracing / observability
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
